{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "lighter_stats",
        "model": {
          "type": "minecraft:model",
          "model": "cigaro:item/lighter_stats"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/flint_and_steel"
    }
  }
}