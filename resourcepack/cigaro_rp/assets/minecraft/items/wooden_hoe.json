{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/wooden_hoe"
    },
    "cases":[
      {
        "when": "pipe_empty",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "fallback": { "type": "minecraft:model", "model": "cigaro:item/pipe_empty_3d" },
          "cases":[
            { "when": ["gui", "ground", "fixed"], "model": { "type": "minecraft:model", "model": "cigaro:item/pipe_empty" } }
          ]
        }
      },
      {
        "when": "pipe_loaded",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "fallback": { "type": "minecraft:model", "model": "cigaro:item/pipe_loaded_3d" },
          "cases": [
            { "when": ["gui", "ground", "fixed"], "model": { "type": "minecraft:model", "model": "cigaro:item/pipe_tabaccoinside" } }
          ]
        }
      },
      {
        "when": "pipe_burning",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "fallback": { "type": "minecraft:model", "model": "cigaro:item/pipe_burning_3d" },
          "cases": [
            { "when":["gui", "ground", "fixed"], "model": { "type": "minecraft:model", "model": "cigaro:item/pipe_working" } }
          ]
        }
      }
    ]
  }
}