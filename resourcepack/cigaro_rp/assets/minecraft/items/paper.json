        }
      },
      {
        "when": "tobacco_crop_oriental_stage2",
        "model": {
          "type": "minecraft:model",
          "model": "cigaro:item/tobacco_crop_oriental_stage2"
        }
      },
      {
        "when": "tobacco_crop_dark_fired_stage2",
        "model": {
          "type": "minecraft:model",
          "model": "cigaro:item/tobacco_crop_dark_fired_stage2"
        }
      },
      {
        "when": "tobacco_crop_virginia_stage3",
        "model": {
          "type": "minecraft:model",
          "model": "cigaro:item/tobacco_crop_virginia_stage3"
        }
      },
      {
        "when": "tobacco_crop_burley_stage3",
